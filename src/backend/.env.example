NODE_ENV=development
PORT=3333

# Banco PostgreSQL local, Docker ou Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corrige_ai
DB_APPLICATION_NAME=instituto-ponte-api
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=8000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000

# Autenticacao Supabase/JWT.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_JWT_SECRET=troque-por-um-segredo-jwt-local
SUPABASE_JWT_ISSUER=

# OAuth Google usado pelo login de professor/coordenador.
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Use AUTH_MODE=test apenas em ambientes locais/controlados sem OAuth real.
AUTH_MODE=

# Chave de 32+ caracteres usada na cifragem/migracao de CPF.
CPF_ENCRYPTION_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres

# Link publico do portal do aluno usado ao publicar provas.
ALUNO_BASE_URL=http://localhost:5173/aluno/prova

# Encerramento/rotina de expiracao de provas.
EXPIRATION_SWEEP_INTERVAL_MS=60000

# E-mail. O adapter fake evita envio real em desenvolvimento.
EMAIL_ADAPTER=fake
EMAIL_PROVIDER=
EMAIL_WEBHOOK_URL=
EMAIL_API_KEY=
EMAIL_FROM=Corrije Aí <noreply@example.com>
EMAIL_FAIL_MODE=
EMAIL_TIMEOUT_MS=5000
EMAIL_RETRY_ATTEMPTS=2
EMAIL_RETRY_BACKOFF_MS=100
EMAIL_CIRCUIT_FAILURE_THRESHOLD=3
EMAIL_CIRCUIT_RESET_MS=30000

# Storage opcional para exportacoes/anexos.
SUPABASE_STORAGE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=exports
STORAGE_TIMEOUT_MS=8000
STORAGE_RETRY_ATTEMPTS=2
STORAGE_RETRY_BACKOFF_MS=100
